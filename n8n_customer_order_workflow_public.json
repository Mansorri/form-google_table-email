          "conditions": [
            {
              "id": "0a740f38-4997-492f-a343-ac70d2cb2209",
              "leftValue": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.email) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "e6b85f3b-d507-4533-a675-aeca6437e5bb",
              "leftValue": "={{ /^\\+[1-9]\\d{6,14}$/.test($json.phone) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "3a5bcfcc-2492-41d0-b64c-07aff69663f8",
              "leftValue": "={{ String($json.product ?? '').trim().length > 0 }}",
