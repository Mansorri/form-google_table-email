    {
      "parameters": {
        "sendTo": "owner@example.com",
        "subject": "New Customer Order",
        "message": "=<h2>New Customer Order</h2>\n\n<p>A new customer order has been received.</p>\n\n<hr>\n\n<p><b>Customer Email:</b> {{ $('Edit Fields').item.json.email }}</p>\n\n<p><b>Country:</b> {{ $('Edit Fields').item.json.country }}</p>\n\n<p><b>Phone:</b> {{ $('Edit Fields').item.json.phone }}</p>\n\n<p><b>Product:</b> {{ $('Edit Fields').item.json.product }}</p>\n\n<p><b>Quantity:</b> {{ $('Edit Fields').item.json.quantity }}</p>\n\n<p><b>Order Date:</b> {{ $('Edit Fields').item.json.order_date }}</p>\n\n<hr>",
        "options": {
          "appendAttribution": false
        }
