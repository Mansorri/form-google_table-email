{
  "name": "form-google_table-email",
  "nodes": [
    {
      "parameters": {
        "content": "1\\. Create an n8n Workflow — Set up a sequence of automated actions.\n\n2\\. Configure a Webhook — Create a dedicated URL to receive new order data from a form or another service.\n\n3\\. Validate Incoming Data — Check whether the required information, such as the customer's name, phone number, product, and quantity, is provided and valid.\n\n4\\. Save Orders to Google Sheets — Automatically add each new order as a separate row in a spreadsheet.\n\n5\\. Send Email Notifications to the Business Owner — Automatically notify the business owner whenever a new order is received.\n\n6\\. Implement Error Handling — Handle situations where order data is invalid or Google Sheets is unavailable.\n\n7\\. Test the Automation — Submit several test orders and verify that the entire workflow functions correctly.",
        "height": 592,
        "width": 416,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
